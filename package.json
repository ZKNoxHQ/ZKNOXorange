{
  "name": "zknox-orange",
  "version": "2.1.0",
  "description": "ZKNOX Orange - Ledger Sideloader (Web Crypto API)",
  "type": "module",
  "scripts": {
    "build": "npx esbuild src/index.js --bundle --format=esm --outfile=dist/ledgerjs.bundle.js --platform=browser",
    "watch": "npx esbuild src/index.js --bundle --format=esm --outfile=dist/ledgerjs.bundle.js --platform=browser --watch",
    "serve": "python3 -m http.server 8080 --directory .."
  },
  "dependencies": {
    "@noble/hashes": "2.0.1",
    "@noble/secp256k1": "3.0.0",
    "esbuild": "^0.27.3"
  }
}
